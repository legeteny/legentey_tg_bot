# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Таймаут long polling в секундах
POLL_TIMEOUT_SECONDS=30

# Ваш личный chat_id в Telegram (он же ваш user_id) — если задан:
# - бот при старте пришлёт вам сообщение с последним коммитом
# - только этот user_id сможет использовать команду /q (см. ниже)
# узнать id можно у @userinfobot
ADMIN_CHAT_ID=

# URL сервиса quote-api (рендерит картинки для /q). Необязательно — при запуске
# через docker-compose уже настроен на встроенный сервис quote-api
QUOTE_API_URL=
